# QA-Core Agent — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# ─── Required: Anthropic API ─────────────────────────────────
# Used by the agent runtime for all tool-use loops.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Model routing (optional, sensible defaults provided) ────
# Per-stage model overrides. The older QA_CORE_MODEL_* spellings
# (QA_CORE_MODEL_PLANNER / QA_CORE_MODEL_EXPLORE / QA_CORE_MODEL_CRITIC)
# still work; these names win when both are set.
# Planner (page snapshot -> scenario list). Haiku is plenty.
QA_CORE_PLANNER_MODEL=claude-haiku-4-5
# Explorer (the tool-use loop that drives the browser). Opus for complex flows.
QA_CORE_EXPLORER_MODEL=claude-opus-4-7
# Critic (reviews recorded scenarios, gates rework/reject before replay).
QA_CORE_CRITIC_MODEL=claude-sonnet-4-6
# Lighter model for transcription / refactor passes.
QA_CORE_MODEL_TRANSCRIBE=claude-sonnet-4-6
# Smallest model for low-risk routing decisions.
QA_CORE_MODEL_ROUTER=claude-haiku-4-5

# ─── Budgets ─────────────────────────────────────────────────
# Hard ceiling on Explorer tool calls per run.
QA_CORE_MAX_STEPS=40
# Cost ceiling in USD per run (default 2.00). Hitting it no longer aborts:
# the Explorer stops cleanly, completed scenarios are kept, and the rest of
# the pipeline runs on them. Multi-page runs (--discover / --urls / --srs)
# cover more pages and scenarios, so give them a higher ceiling, e.g. 5.00.
# The older QA_CORE_MAX_USD name still works; this name wins when both are set.
QA_CORE_COST_CEILING=2.00

# ─── Optional: storage-state auth ────────────────────────────
# Set these to capture a logged-in session once via `npm run auth:setup`.
# Subsequent runs reuse the saved session — no login in every test.
# QA_CORE_AUTH_URL=https://example.com/login
# QA_CORE_AUTH_USER=
# QA_CORE_AUTH_PASS=
