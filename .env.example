# QA-Core Agent — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# ─── Required: Anthropic API ─────────────────────────────────
# Used by the agent runtime for all tool-use loops.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Model routing (optional, sensible defaults provided) ────
# Default explorer/coder model. Opus for complex flows.
QA_CORE_MODEL_EXPLORE=claude-opus-4-7
# Lighter model for transcription / refactor passes.
QA_CORE_MODEL_TRANSCRIBE=claude-sonnet-4-6
# Smallest model for low-risk routing decisions.
QA_CORE_MODEL_ROUTER=claude-haiku-4-5

# ─── Budgets ─────────────────────────────────────────────────
# Hard ceilings per /explore run. Agent refuses to start if exceeded.
QA_CORE_MAX_STEPS=40
QA_CORE_MAX_USD=2.00

# ─── Optional: storage-state auth ────────────────────────────
# Set these to capture a logged-in session once via `npm run auth:setup`.
# Subsequent runs reuse the saved session — no login in every test.
# QA_CORE_AUTH_URL=https://example.com/login
# QA_CORE_AUTH_USER=
# QA_CORE_AUTH_PASS=
